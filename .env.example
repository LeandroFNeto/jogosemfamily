HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/mesa.sqlite
# Ao publicar, configure a origem HTTPS exata e termine TLS no proxy.
# PUBLIC_ORIGIN=https://mesa.exemplo.com

# Canal WhatsApp (opcional): sem estas variáveis o servidor atende só a web.
# WPPConnect server (veja deploy/wppconnect/docker-compose.yml e docs/whatsapp.md).
# WPP_URL=http://127.0.0.1:21465
# WPP_SECRET_KEY=troque-por-um-segredo-longo
# WPP_SESSION=mesa-familia
# Número do bot, só dígitos com país e DDD (usado no link wa.me).
# WHATSAPP_BOT_NUMBER=5511999999999
# Segredo anexado à URL do webhook e token das rotas /admin/whatsapp/*.
# WHATSAPP_WEBHOOK_SECRET=troque-por-outro-segredo-longo
# WHATSAPP_ADMIN_TOKEN=troque-por-um-token-de-administracao
# URL pela qual o WPPConnect alcança este servidor (padrão: PUBLIC_ORIGIN).
# WHATSAPP_WEBHOOK_BASE=http://host.docker.internal:3000
# Chave que cifra os endereços dos jogadores (padrão: WHATSAPP_WEBHOOK_SECRET).
# WHATSAPP_DATA_KEY=troque-por-uma-chave-longa
# Botões e listas do WhatsApp: on (padrão) ou off para enviar só texto numerado.
# WHATSAPP_INTERACTIVE=on

# Banco de imagens do quebra-cabeça (opcional): o catálogo embutido sempre funciona.
# IMAGE_API_URL=https://imagens.exemplo.com/lista.json
# IMAGE_API_KEY=token-opcional
# IMAGE_API_HOSTS=cdn.exemplo.com
# IMAGE_CACHE_DIR=./data/images

# Operação: saúde, métricas e avisos ao administrador.
# Token de /metrics (com WhatsApp configurado, vale WHATSAPP_ADMIN_TOKEN).
# ADMIN_TOKEN=troque-por-um-token-de-administracao
# Número do administrador que recebe o aviso de bot fora do ar (dígitos, com país e DDD).
# ADMIN_PHONE=5511999999999
# Pasta das cópias diárias do banco (7 mais recentes). Copie-a para fora do servidor.
# BACKUP_DIR=./backups
# Retenção, em dias: mensagens processadas, fila de saída enviada e mesas encerradas.
# RETENTION_MESSAGES_DAYS=7
# RETENTION_OUTBOX_DAYS=7
# RETENTION_ROOMS_DAYS=30

# Origem web que o bot usa nos links pessoais da partida (o jogo acontece na web).
# Em casa: o endereço do notebook na rede, ex.: http://192.168.0.10:3000 (só aparelhos na mesma rede abrem).
# Para jogar de qualquer lugar use um túnel ou domínio com HTTPS (PUBLIC_ORIGIN tem prioridade).
# WEB_BASE_URL=http://192.168.0.10:3000
